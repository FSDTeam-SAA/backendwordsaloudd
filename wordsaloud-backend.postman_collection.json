{
  "info": {
    "name": "WordSaloud Backend API",
    "description": "Auto-generated from wordsaloud-backend source. Base path: /api/v1. Auth uses Bearer JWT access token in Authorization header.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "wordsaloud-backend-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "tradesmanId", "value": "" },
    { "key": "advertisementId", "value": "" }
